rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- helpers ----------
    // Mirrors the authorization logic in firestore.rules. Storage rules
    // can't call Firestore's get()/exists() directly, so we go through the
    // firestore.* cross-service functions instead.

    function isSignedIn() {
      return request.auth != null;
    }

    function isDunepebblerStaff() {
      return isSignedIn() && request.auth.token.email.matches('.*@dunepebbler[.]nl$');
    }

    function isSuperAdmin() {
      return isDunepebblerStaff() || (
        isSignedIn() &&
        firestore.exists(/databases/(default)/documents/config/superadmin) &&
        firestore.get(/databases/(default)/documents/config/superadmin).data.authorizedUsers.hasAny([request.auth.token.email])
      );
    }

    function tenantUsers(tenantId) {
      return firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.authorizedUsers;
    }

    function isAuthorized(tenantId) {
      let email = request.auth.token.email;
      return isSuperAdmin() || (
        isSignedIn() && (
          tenantUsers(tenantId).hasAny([email]) ||
          tenantUsers(tenantId).hasAny([{'email': email, 'role': 'admin'}]) ||
          tenantUsers(tenantId).hasAny([{'email': email, 'role': 'editor'}])
        )
      );
    }

    // ---------- tenant-scoped media ----------
    // slides/, logos/ and audio/ all live under tenants/{tenantId}/... and
    // are shown publicly on unauthenticated display screens, so reads stay
    // open. Writes require tenant membership (or superadmin).

    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized(tenantId);
    }

    // Deny everything else by default (no catch-all).
  }
}
