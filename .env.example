# Firebase Configuration Template
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Microsoft OAuth (optional — enables Microsoft login button)
# Get this from Azure Portal → App registrations → your app → Application (client) ID
REACT_APP_MICROSOFT_CLIENT_ID=your-azure-client-id

# Server-only: Firebase Admin SDK service account (used by /api/v1/* endpoints)
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the full JSON as a single line. Never prefix with REACT_APP_ — this must
# never be bundled into client-side code.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
